# SynPharm - PC 端环境变量模板
# 复制此文件为 .env.local 并填入实际值

# 应用配置
VITE_APP_TITLE=SynPharm
VITE_APP_VERSION=1.0.0

# API 配置
# 注意：该地址必须与 deploy/.env 中的 BACKEND_PORT 一致。
# Docker 部署时后端映射到宿主机 7000（见 deploy/docker-compose.yml），
# 因此本地开发直连时请写 http://localhost:7000，而非 8080。
# 留空则走相对路径（生产同源反代由 nginx 处理）。
VITE_API_BASE_URL=http://localhost:7000
VITE_API_TIMEOUT=30000

# Mock 模式配置
VITE_ENABLE_MOCK=true
VITE_MOCK_DELAY=800

# 设计工作台（/design）数据源开关
# 该模块的接口尚未实现，默认使用内置演示数据；
# 后端就绪后设为 false 即切到真实接口，页面代码无需改动。
VITE_DESIGN_MOCK=true

# 功能开关
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false

# 第三方服务配置（如有）
# VITE_GA_ID=
# VITE_SENTRY_DSN=

# 开发环境配置
VITE_DEV_PORT=5174
VITE_DEV_HOST=0.0.0.0
