<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.synpharm.repository.mapper.PredictTaskMapper">

    <!-- 根据用户ID查询任务列表（排除已删除，按创建时间倒序） -->
    <select id="selectByUserId" resultType="com.synpharm.model.entity.PredictTask">
        SELECT * FROM predict_task
        WHERE user_id = #{userId} AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- 根据任务编号查询任务（排除已删除） -->
    <select id="selectByTaskNo" resultType="com.synpharm.model.entity.PredictTask">
        SELECT * FROM predict_task
        WHERE task_no = #{taskNo} AND deleted = 0
    </select>

</mapper>
