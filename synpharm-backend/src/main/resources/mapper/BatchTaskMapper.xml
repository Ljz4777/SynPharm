<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.synpharm.repository.mapper.BatchTaskMapper">

    <select id="selectByBatchId" resultType="com.synpharm.model.entity.BatchTask">
        SELECT * FROM batch_task WHERE batch_id = #{batchId} AND deleted = 0
    </select>

    <select id="selectByUserId" resultType="com.synpharm.model.entity.BatchTask">
        SELECT * FROM batch_task WHERE user_id = #{userId} AND deleted = 0 ORDER BY create_time DESC
    </select>

</mapper>
