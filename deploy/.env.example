# =============================================================================
# SynPharm 环境变量模板
#
# 使用方法：复制本文件为 .env 并修改其中的值（.env 已被 gitignore，不会提交）
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# 生成强随机密钥（生产环境必做）：
#   openssl rand -hex 32
# =============================================================================

# ---------- 版本标签（用于镜像命名）----------
SYNPHARM_VERSION=1.0.0

# ---------- MySQL ----------
# 生产环境请务必修改！生成示例：openssl rand -base64 18
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=synpharm
MYSQL_USER=synpharm
MYSQL_PASSWORD=change-me-synpharm
MYSQL_PORT=3306

# ---------- Redis ----------
# 内网开发默认无密码；生产请设置强密码并同步给后端 REDIS_PASSWORD
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT（安全关键，生产必须改为 32 字节以上的强随机值）----------
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes
JWT_EXPIRATION=86400000

# ---------- FastAPI 算法引擎 ----------
FASTAPI_PORT=8000
# 推理设备：cpu / cuda:0
FASTAPI_DEVICE=cpu
FASTAPI_BATCH_SIZE=50
# 后端调用算法引擎时携带的单一 API Key（开启认证必填，如 synpharm-secret-key）
FASTAPI_API_KEY=
# FastAPI 接受的全部 API Key（逗号分隔，可多个）；留空则回退到 FASTAPI_API_KEY；
# 两者都留空 = 关闭认证（仅限内网开发）
FASTAPI_API_KEYS=
FASTAPI_LOG_LEVEL=INFO

# ---------- SpringBoot 后端 ----------
BACKEND_PORT=8080

# ---------- 前端 ----------
# 容器内 Nginx 监听 8080，映射到宿主机端口（默认 80）
FRONTEND_PORT=80

# ---------- QQ 邮箱（可选，用于发送验证码；留空则无法发送邮件）----------
QQ_EMAIL=
QQ_EMAIL_AUTH_CODE=
