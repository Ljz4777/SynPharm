# Windows 系统下自动转换为 CRLF（提交时转为 LF）
* text=auto eol=crlf

# 代码文件保持 LF 格式
*.java text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf

# 二进制文件不处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
