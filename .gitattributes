# Windows 系统下自动转换为 CRLF（提交时转为 LF）
* text=auto eol=crlf

# 代码文件保持 LF 格式
*.java text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf

# 脚本换行：shell 脚本必须 LF，否则 Linux/WSL/macOS 下会因行尾 \r 报
# "bash: $'\r': command not found"；Windows 脚本保持 CRLF
*.sh  text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
